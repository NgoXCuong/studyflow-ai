# Copy to .env and set a local password before starting Docker Compose.
POSTGRES_PASSWORD=replace-with-your-local-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=studyflow
POSTGRES_USER=studyflow

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
FRONTEND_URL=http://localhost:3000
# Set false for local demos without sending verification emails; enable for real use.
EMAIL_VERIFICATION_REQUIRED=true
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
VERIFICATION_TOKEN_HOURS=24
RESET_TOKEN_MINUTES=30

# Local HTTP only; set true when deploying with HTTPS.
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Local inbox: docker compose --profile mail up -d mail
# Read emails at http://localhost:8025. Use a real SMTP service for deployment.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@studyflow.local

# Private PDF storage; relative paths are resolved from the backend directory.
DOCUMENT_STORAGE_DIR=storage/documents
DOCUMENT_MAX_SIZE_BYTES=20971520
DOCUMENT_MAX_PAGES=500
# local for development, r2 for private Cloudflare object storage.
DOCUMENT_STORAGE_BACKEND=local
# Includes soft-deleted files until cleanup succeeds: default 1 GiB per user.
DOCUMENT_USER_QUOTA_BYTES=1073741824
DOCUMENT_RETENTION_DAYS=7
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# M05: Select cohere or gemini; vectors stay fixed at 768 dimensions.
EMBEDDING_PROVIDER=cohere
COHERE_API_KEY=
COHERE_EMBEDDING_MODEL=embed-v5.0-fast
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
DOCUMENT_CHUNK_SIZE=1500
DOCUMENT_CHUNK_OVERLAP=200
DOCUMENT_MAX_CHUNKS=1000
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=30
PROCESSING_LEASE_SECONDS=300
# Run a separate durable worker from backend: python -m app.services.document_processing
